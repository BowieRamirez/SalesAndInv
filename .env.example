# Neon Postgres (project: autumn-hall-59133506 — FurniTrack)
# Get your connection string from: https://console.neon.tech/app/projects/autumn-hall-59133506
DATABASE_URL="postgresql://<user>:<password>@<host>/neondb?sslmode=require"

# Neon Auth
# Get these from Neon Console -> Project -> Branch -> Auth -> Configuration
NEON_AUTH_BASE_URL="https://<your-neon-auth-host>/<database>/auth"
NEON_AUTH_COOKIE_SECRET="<your-cookie-secret>"

# Resend — email sending for password reset OTP
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="FurniTrack <onboarding@resend.dev>"
