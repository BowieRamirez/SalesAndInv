// FurniTrack schema — minimized 6-role business system.
// Dropped tables: companies, leads, design_requests, design_assets

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_MANAGEMENT
  SALES
  INVENTORY
  ACCOUNTING
  OPERATIONS_DESIGN
  CUSTOM
  CLIENT
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  PENDING_ACTIVATION
}

enum OrderType {
  CUSTOMIZED
  SUPPLY
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum SalesOrderStatus {
  DRAFT
  PENDING_FULFILLMENT
  PROCESSING
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum InventoryRequestStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  OUT_OF_STOCK
  REJECTED
}

enum StockAvailabilityStatus {
  AVAILABLE
  PARTIAL
  OUT_OF_STOCK
}

enum AccountingStatus {
  PENDING_REVIEW
  WAITING_FOR_DOWN_PAYMENT
  PARTIALLY_PAID
  FULLY_PAID
  FINANCIALLY_CLEARED
  ON_HOLD
}

enum PaymentType {
  DOWN_PAYMENT
  PARTIAL_PAYMENT
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DeliveryStatus {
  BLOCKED
  SCHEDULED
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryReadinessStatus {
  BLOCKED_BY_APPROVALS
  BLOCKED_BY_PAYMENT
  BLOCKED_BY_STOCK
  BLOCKED_BY_DESIGN
  READY
}

enum InquiryStatus {
  RECEIVED
  ACCEPTED
  PENDING_INVENTORY_APPROVAL
  GETTING_READY_FOR_BUILDING
  WAITING_FOR_PAYMENT
  PENDING_ACCOUNTING_APPROVAL
  READY_FOR_SHIPMENT
  READY_FOR_SHIPPING
  COMPLETED
}

enum StockState {
  AVAILABLE
  RESERVED
  DAMAGED
  ARCHIVED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  DAMAGE
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_BLOCKED
  USER_REMOVED
  CLIENT_CREATED
  COMPANY_CODE_ASSIGNED
  COMPANY_CODE_CHANGED
  STOCK_REQUEST_APPROVED
  STOCK_REQUEST_REJECTED
  PAYMENT_UPDATED
  DELIVERY_SCHEDULE_CHANGED
  PAYMENT_ACCEPTED
  RETURN_ACCEPTED
  CHAT_MESSAGE_SENT
  INVENTORY_REQUESTED
  STOCK_ADDED
  STOCK_REMOVED
  BUILDING_APPROVED
  DELIVERY_SCHEDULED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_APPROVED
  PURCHASE_ORDER_REJECTED
  GOODS_RECEIVED
}

enum AuditEntityType {
  USER
  SALES_ORDER
  STOCK_REQUEST
  PAYMENT
  DELIVERY_SCHEDULE
  RETURN_REQUEST
  CHAT
  INVENTORY
  STOCK
  BUILDING_PROJECT
  PRODUCT
  PURCHASE_ORDER
}

enum ApprovalModule {
  SALES_ORDER
  STOCK_REQUEST
  PAYMENT
  DELIVERY_SCHEDULE
  CUSTOMER_INQUIRY
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED_FOR_REVISION
  FINALIZED
}

model User {
  id              String        @id @default(cuid())
  authUserId      String?       @unique @db.Uuid
  name            String
  email           String        @unique
  role            UserRole
  status          AccountStatus @default(ACTIVE)
  accessStartsAt  DateTime?
  accessExpiresAt DateTime?
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  phone           String?
  address         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  permissions     Json?

  salesOrdersCreated           SalesOrder[]       @relation("SalesOrderCreatedBy")
  stockRequestsRaised          StockRequest[]     @relation("StockRequestRequestedBy")
  stockRequestsChecked         StockRequest[]     @relation("StockRequestDecidedBy")
  paymentsRecorded             PaymentRecord[]    @relation("PaymentRecordedBy")
  paymentsVerified             PaymentRecord[]    @relation("PaymentVerifiedBy")
  deliveryAssigned             DeliverySchedule[] @relation("DeliveryAssignedBy")
  deliveryConfirmed            DeliverySchedule[] @relation("DeliveryConfirmedBy")
  customerInquiries            CustomerInquiry[]  @relation("CustomerInquiryUser")
  inquiriesSalesReviewed       CustomerInquiry[]  @relation("InquirySalesReviewedBy")
  inquiriesInventoryApproved   CustomerInquiry[]  @relation("InquiryInventoryApprovedBy")
  inquiriesAccountingConfirmed CustomerInquiry[]  @relation("InquiryAccountingConfirmedBy")
  inquiriesBuildApproved       CustomerInquiry[]  @relation("InquiryBuildApprovedBy")
  inquiriesCompleted           CustomerInquiry[]  @relation("InquiryCompletedBy")
  inquiriesCancelled           CustomerInquiry[]  @relation("InquiryCancelledBy")
  orderChatMessages            OrderChatMessage[]
  draftProducts                DraftProduct[]     @relation("DraftProductCreatedBy")

  @@index([role, status])
  @@map("users")
}

/// Formal sales orders for B2B / multi-line workflow.
/// Flow: SalesOrder → StockRequest → PaymentRecord → DeliverySchedule.
/// For B2C single-product storefront orders see CustomerInquiry.
/// A sales order can optionally be converted from a CustomerInquiry via convertedFromInquiryId.
model SalesOrder {
  id                     String                 @id @default(cuid())
  soNumber               String                 @unique
  convertedFromInquiryId String?
  createdById            String
  orderType              OrderType
  status                 SalesOrderStatus       @default(DRAFT)
  inventoryStatus        InventoryRequestStatus @default(NOT_REQUIRED)
  accountingStatus       AccountingStatus       @default(PENDING_REVIEW)
  deliveryStatus         DeliveryStatus         @default(BLOCKED)
  companyCodeSnapshot    String
  clientContactName      String
  clientContactEmail     String?
  clientContactPhone     String?
  projectAddress         String?
  deliveryAddress        String?
  requestedDeliveryAt    DateTime?
  subtotal               Decimal
  discountAmount         Decimal                @default(0)
  vatAmount              Decimal                @default(0)
  total                  Decimal
  readyForDeliveryAt     DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  createdBy            User                 @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  convertedFromInquiry CustomerInquiry?     @relation("InquiryConvertedToSalesOrder", fields: [convertedFromInquiryId], references: [id])
  lineItems            SalesOrderLineItem[]
  stockRequests        StockRequest[]
  paymentRecords       PaymentRecord[]
  deliverySchedules    DeliverySchedule[]

  @@index([status, companyCodeSnapshot])
  @@index([convertedFromInquiryId])
  @@map("sales_orders")
}

/// Line items for B2B sales_orders.
model SalesOrderLineItem {
  id           String  @id @default(cuid())
  salesOrderId String
  itemCode     String?
  productName  String
  description  String?
  quantity     Int
  unitPrice    Decimal
  lineTotal    Decimal

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@map("sales_order_line_items")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productStocks  ProductStock[]
  materialStocks MaterialStock[]

  @@map("warehouses")
}

model ProductStock {
  id               String     @id @default(cuid())
  warehouseId      String
  sku              String     @unique
  itemName         String
  description      String?
  unitOfMeasure    String     @default("pcs")
  availableQty     Int        @default(0)
  reservedQty      Int        @default(0)
  reorderThreshold Int        @default(10)
  state            StockState @default(AVAILABLE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  product        Product?
  stockMovements StockMovement[]

  @@index([warehouseId, state])
  @@map("product_stocks")
}

model MaterialStock {
  id               String     @id @default(cuid())
  warehouseId      String
  sku              String     @unique
  itemName         String
  description      String?
  unitOfMeasure    String     @default("pcs")
  availableQty     Int        @default(0)
  reservedQty      Int        @default(0)
  reorderThreshold Int        @default(10)
  state            StockState @default(AVAILABLE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  materialFor       ProductMaterial[]  @relation("ProductMaterialStockItem")
  stockMovements    StockMovement[]
  stockRequestLines StockRequestLine[]

  @@index([warehouseId, state])
  @@map("material_stocks")
}

model Product {
  id             String   @id @default(cuid())
  productStockId String   @unique
  slug           String   @unique
  name           String
  category       String
  material       String
  price          Decimal
  originalPrice  Decimal?
  badge          String?
  images         Json?
  colorVariants  Json     @default("[]")
  rating         Decimal  @default(0)
  reviewCount    Int      @default(0)
  widthCm        Decimal
  depthCm        Decimal
  heightCm       Decimal
  weightKg       Decimal
  description    String
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productStock ProductStock      @relation(fields: [productStockId], references: [id])
  materials    ProductMaterial[]
  inquiries    CustomerInquiry[]

  @@index([category, isPublished])
  @@map("products")
}

model DraftProduct {
  id          String    @id @default(cuid())
  createdById String
  name        String?
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User @relation("DraftProductCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, deletedAt, updatedAt])
  @@map("draft_products")
}

/// B2C single-product orders from the storefront.
/// One inquiry -> one product (via productId). For multi-line B2B orders see SalesOrder.
model CustomerInquiry {
  id             String        @id @default(cuid())
  productId      String
  customerUserId String?
  customerName   String
  customerEmail  String
  customerPhone  String
  message        String
  status         InquiryStatus @default(RECEIVED)
  statusNote     String?
  inquiryNumber  String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Stage transition timestamps
  salesReviewedAt       DateTime?
  inventoryApprovedAt   DateTime?
  customerPaidAt        DateTime?
  accountingConfirmedAt DateTime?
  buildApprovedAt       DateTime?
  shippingScheduledAt   DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?

  // Stage actor IDs (FK to User)
  salesReviewedById       String?
  inventoryApprovedById   String?
  accountingConfirmedById String?
  buildApprovedById       String?
  completedById           String?
  cancelledById           String?

  product                Product            @relation(fields: [productId], references: [id])
  customerUser           User?              @relation("CustomerInquiryUser", fields: [customerUserId], references: [id])
  chatMessages           OrderChatMessage[]
  paymentRecords         PaymentRecord[]    @relation("InquiryPaymentRecords")
  convertedToSalesOrders SalesOrder[]       @relation("InquiryConvertedToSalesOrder")

  salesReviewedBy       User? @relation("InquirySalesReviewedBy", fields: [salesReviewedById], references: [id])
  inventoryApprovedBy   User? @relation("InquiryInventoryApprovedBy", fields: [inventoryApprovedById], references: [id])
  accountingConfirmedBy User? @relation("InquiryAccountingConfirmedBy", fields: [accountingConfirmedById], references: [id])
  buildApprovedBy       User? @relation("InquiryBuildApprovedBy", fields: [buildApprovedById], references: [id])
  completedBy           User? @relation("InquiryCompletedBy", fields: [completedById], references: [id])
  cancelledBy           User? @relation("InquiryCancelledBy", fields: [cancelledById], references: [id])

  @@index([customerUserId, status, createdAt])
  @@index([productId, status, createdAt])
  @@map("customer_inquiries")
}

model OrderChatMessage {
  id           String   @id
  inquiryId    String   @map("inquiry_id")
  senderUserId String?  @map("sender_user_id")
  senderRole   String   @map("sender_role")
  body         String?
  createdAt    DateTime @default(now()) @map("created_at")

  inquiry     CustomerInquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender      User?                 @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments OrderChatAttachment[]

  @@index([inquiryId, createdAt])
  @@map("order_chat_messages")
}

model OrderChatAttachment {
  id             String   @id
  messageId      String   @map("message_id")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  attachmentType String   @map("attachment_type")
  dataUrl        String   @map("data_url")
  createdAt      DateTime @default(now()) @map("created_at")

  message OrderChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("order_chat_attachments")
}

model ProductMaterial {
  id               String   @id @default(cuid())
  productId        String
  materialStockId  String
  quantityRequired Decimal?
  quantityDisplay  String?
  dimension        String?
  notes            String?
  createdAt        DateTime @default(now())

  product       Product       @relation(fields: [productId], references: [id])
  materialStock MaterialStock @relation("ProductMaterialStockItem", fields: [materialStockId], references: [id])

  @@index([materialStockId])
  @@map("product_materials")
}

model StockMovement {
  id              String            @id @default(cuid())
  materialStockId String?
  productStockId  String?
  type            StockMovementType
  quantity        Int
  requesterName   String?
  projectPurpose  String?
  referenceNumber String?
  createdAt       DateTime          @default(now())

  materialStock MaterialStock? @relation(fields: [materialStockId], references: [id])
  productStock  ProductStock?  @relation(fields: [productStockId], references: [id])

  @@map("stock_movements")
}

model StockRequest {
  id                  String                 @id @default(cuid())
  salesOrderId        String
  requestedById       String
  decidedById         String?
  status              InventoryRequestStatus @default(PENDING)
  requestedAt         DateTime               @default(now())
  decidedAt           DateTime?
  purpose             String?
  deductionFormNumber String?
  remarks             String?

  salesOrder  SalesOrder         @relation(fields: [salesOrderId], references: [id])
  requestedBy User               @relation("StockRequestRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?              @relation("StockRequestDecidedBy", fields: [decidedById], references: [id])
  lineItems   StockRequestLine[]

  @@index([salesOrderId, status])
  @@map("stock_requests")
}

model StockRequestLine {
  id                String                  @id @default(cuid())
  stockRequestId    String
  materialStockId   String
  quantityRequested Int
  quantityApproved  Int                     @default(0)
  availability      StockAvailabilityStatus @default(AVAILABLE)

  stockRequest  StockRequest  @relation(fields: [stockRequestId], references: [id])
  materialStock MaterialStock @relation(fields: [materialStockId], references: [id])

  @@map("stock_request_line_items")
}

model PaymentRecord {
  id               String        @id @default(cuid())
  salesOrderId     String?
  inquiryId        String?
  paymentNumber    String?       @unique
  recordedById     String
  paymentType      PaymentType
  paymentMethod    String?
  status           PaymentStatus @default(PENDING)
  amount           Decimal
  remainingBalance Decimal
  paymentDate      DateTime
  referenceNumber  String?
  remarks          String?
  verifiedAt       DateTime?
  verifiedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  salesOrder SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  inquiry    CustomerInquiry? @relation("InquiryPaymentRecords", fields: [inquiryId], references: [id], onDelete: Cascade)
  recordedBy User             @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy User?            @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([salesOrderId, status, paymentDate])
  @@index([inquiryId, status, paymentDate])
  @@map("payment_records")
}

model DeliverySchedule {
  id                  String                  @id @default(cuid())
  salesOrderId        String
  assignedById        String
  confirmedById       String?
  scheduledAt         DateTime
  status              DeliveryStatus          @default(BLOCKED)
  readinessStatus     DeliveryReadinessStatus @default(BLOCKED_BY_APPROVALS)
  companyCodeSnapshot String
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id])
  assignedBy  User       @relation("DeliveryAssignedBy", fields: [assignedById], references: [id])
  confirmedBy User?      @relation("DeliveryConfirmedBy", fields: [confirmedById], references: [id])

  @@index([status, companyCodeSnapshot])
  @@map("delivery_schedules")
}

model ApprovalHistory {
  id         String         @id @default(cuid())
  module     ApprovalModule
  recordId   String
  action     ApprovalAction
  fromStatus String?
  toStatus   String?
  remarks    String?
  actedById  String
  actedAt    DateTime       @default(now())

  @@index([module, recordId, actedAt])
  @@map("approval_history")
}

model AuditLog {
  id                  String          @id @default(cuid())
  actorId             String?
  action              AuditAction
  entityType          AuditEntityType
  entityId            String
  companyCodeSnapshot String?
  metadata            Json?
  createdAt           DateTime        @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model StorefrontCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storefront_categories")
}

model AdminAccountArchive {
  id             String   @id @default(cuid())
  originalUserId String   @unique
  name           String
  email          String
  role           String
  archivedAt     DateTime @default(now())

  actions AdminActionArchive[]

  @@map("admin_account_archives")
}

model AdminActionArchive {
  id          String   @id @default(cuid())
  archiveId   String
  actionType  String
  description String
  performedAt DateTime @default(now())
  metadata    Json?

  adminArchive AdminAccountArchive @relation(fields: [archiveId], references: [id])

  @@index([archiveId, performedAt])
  @@map("admin_action_archives")
}

model ReturnRequest {
  id                String    @id @default(cuid())
  inquiryId         String
  customerUserId    String?
  status            String
  reason            String
  details           String?
  imageUrls         Json?
  salesNote         String?
  pickupScheduledAt DateTime?
  approvedById      String?
  approvedAt        DateTime?
  completedById     String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([inquiryId])
  @@index([customerUserId])
  @@map("return_requests")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  GOODS_RECEIVED
  CANCELLED
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  poNumber           String              @unique
  supplierId         String?
  requestedById      String
  approvedById       String?
  status             PurchaseOrderStatus @default(DRAFT)
  totalAmount        Decimal             @default(0)
  remarks            String?
  expectedDeliveryAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  materialStockId  String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal?
  lineTotal        Decimal  @default(0)
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}
