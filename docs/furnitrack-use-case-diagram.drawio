        <mxCell id="l_c6" style="endArrow=none;html=1;rounded=0;strokeColor=#374151;" edge="1" parent="1" source="actor_customer" target="uc_track"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l_c7" style="endArrow=none;html=1;rounded=0;strokeColor=#374151;" edge="1" parent="1" source="actor_customer" target="uc_chat"><mxGeometry relative="1" as="geometry"/></mxCell>
