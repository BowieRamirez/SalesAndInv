        <!-- Executive can also do everything other admins do (generalization shown by access to manage products and verify payments via override) -->
        <mxCell id="l_e3" style="endArrow=none;html=1;rounded=0;strokeColor=#9f1239;dashed=1;" edge="1" parent="1" source="actor_exec" target="uc_manage_prod"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- INCLUDE / EXTEND RELATIONSHIPS                             -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- Submit Inquiry «include» Browse -->
        <mxCell id="rel_inc1" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_inquiry" target="uc_browse">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Submit Payment «include» Review Quotation -->
        <mxCell id="rel_inc2" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_pay" target="uc_review_quote">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Cancel Order «extend» Track Order -->
        <mxCell id="rel_ext1" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_cancel" target="uc_track">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Request Return «extend» Track Order -->
        <mxCell id="rel_ext2" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_return" target="uc_track">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Leave Review «extend» Track Order -->
        <mxCell id="rel_ext3" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_review" target="uc_track">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Send Quotation «include» View New Inquiries -->
        <mxCell id="rel_inc3" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_send_quote" target="uc_view_inq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Send Quotation «include» Check Stock -->
        <mxCell id="rel_inc4" value="«include»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_send_quote" target="uc_check_stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Revise Quotation «extend» Send Quotation -->
        <mxCell id="rel_ext4" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;fontStyle=2;fontColor=#6b7280;strokeColor=#6b7280;" edge="1" parent="1" source="uc_revise_quote" target="uc_send_quote">
          <mxGeometry relative="1" as="geometry"/>
