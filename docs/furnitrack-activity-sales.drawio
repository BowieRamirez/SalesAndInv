        <!-- approve return → audit logs -->
        <mxCell id="se20" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s10">
