        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- EDGES                                                      -->
        <!-- ═════════════════════════════════════════════════════════ -->

        <!-- linear top -->
        <mxCell id="se0" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s_start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se1" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- to fork -->
        <mxCell id="se3" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s_fork1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- fork to parallel branches -->
        <mxCell id="se4" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_fork1" target="s4a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_fork1" target="s4b"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- branches to join -->
        <mxCell id="se6" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4a" target="s_join1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se7" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4b" target="s_join1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- join to send quote -->
        <mxCell id="se8" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_join1" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- send → wait → decision -->
        <mxCell id="se9" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se10" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s6" target="s_d1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- decision branches -->
        <mxCell id="se11" value="Decline" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_d1" target="s_revise"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se12" value="Question" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_d1" target="s_chat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se13" value="Accept" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s_d1" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Revise Quotation: → Inquiry Declined end (clean down arrow) -->
        <mxCell id="se14" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_revise" target="s_end_decline"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Chat: loop back up to Wait for Response (clean right side) -->
        <mxCell id="se15" value="loop back" style="endArrow=classic;html=1;strokeColor=#6b7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_chat" target="s6">
