        <mxCell id="se17" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="s8" target="s_d2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Return decision -->
        <mxCell id="se18" value="Yes" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_d2" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>
