      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Sequence Diagram — ACCOUNTING ADMIN" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#7e22ce;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="900" height="30" as="geometry"/></mxCell>

        <!-- Lifelines -->
        <mxCell id="lf_acc" value=":Accounting Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#7e22ce;fontSize=13;fontStyle=1;strokeWidth=2;size=40;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="140" height="960" as="geometry"/></mxCell>
        <mxCell id="lf_adm" value=":Admin Dashboard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f0f9ff;strokeColor=#0369a1;fontColor=#0369a1;fontSize=13;fontStyle=1;strokeWidth=2;size=40;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="140" height="960" as="geometry"/></mxCell>
        <mxCell id="lf_api" value=":API / System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f3f4f6;strokeColor=#374151;fontColor=#374151;fontSize=13;fontStyle=1;strokeWidth=2;size=40;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="140" height="960" as="geometry"/></mxCell>
        <mxCell id="lf_db" value=":Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#c2410c;fontSize=13;fontStyle=1;strokeWidth=2;size=40;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="140" height="960" as="geometry"/></mxCell>

        <!-- 1. Login -->
        <mxCell id="m1" value="1: Log in to Admin Dashboard" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="180" as="sourcePoint"/><mxPoint x="350" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2: Verify session / role = ACCOUNTING" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="210" as="sourcePoint"/><mxPoint x="570" y="210" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3: Dashboard loaded" style="endArrow=open;dashed=1;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="240" as="sourcePoint"/><mxPoint x="200" y="240" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 2. View Pending Payments -->
        <mxCell id="m4" value="4: View orders pending payment confirmation" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="300" as="sourcePoint"/><mxPoint x="570" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5: SELECT inquiries WHERE status = PENDING_ACCOUNTING_APPROVAL" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="330" as="sourcePoint"/><mxPoint x="790" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6: Pending payment list" style="endArrow=open;dashed=1;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="360" as="sourcePoint"/><mxPoint x="200" y="360" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 3. Review Payment Proof -->
        <mxCell id="m7" value="7: Review payment submission + proof" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="420" as="sourcePoint"/><mxPoint x="570" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8: SELECT payment_records + order_chat_attachments" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="450" as="sourcePoint"/><mxPoint x="790" y="450" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9: Payment details + proof images" style="endArrow=open;dashed=1;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="480" as="sourcePoint"/><mxPoint x="200" y="480" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 4. Verify Payment -->
        <mxCell id="m10" value="10: Verify payment (confirm funds received)" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="540" as="sourcePoint"/><mxPoint x="570" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11: UPDATE payment_records status = VERIFIED, UPDATE inquiry status = GETTING_READY_FOR_BUILDING" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="570" as="sourcePoint"/><mxPoint x="790" y="570" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12: Payment verified, order released to operations" style="endArrow=open;dashed=1;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="600" as="sourcePoint"/><mxPoint x="200" y="600" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 5. View Payment History -->
        <mxCell id="m13" value="13: View payment history &amp; records" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="660" as="sourcePoint"/><mxPoint x="570" y="660" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14: SELECT payment_records ORDER BY paymentDate DESC" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="690" as="sourcePoint"/><mxPoint x="790" y="690" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="15: Payment history list" style="endArrow=open;dashed=1;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="720" as="sourcePoint"/><mxPoint x="200" y="720" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 6. View Audit Logs -->
        <mxCell id="m16" value="16: View accounting audit logs" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="780" as="sourcePoint"/><mxPoint x="570" y="780" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="17: SELECT audit_logs WHERE actorId = accountingId" style="endArrow=classic;html=1;strokeColor=#374151;strokeWidth=1.5;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="810" as="sourcePoint"/><mxPoint x="790" y="810" as="targetPoint"/></mxGeometry></mxCell>
