{
  "name": "furnitrack",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:storefront": "pnpm --filter @furnitrack/db generate && pnpm --filter storefront build",
    "build:admin": "pnpm --filter @furnitrack/db generate && pnpm --filter admin build",
    "dev": "pnpm --filter @furnitrack/db generate && turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "latest",
    "turbo": "^2.9.12",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  }
}
