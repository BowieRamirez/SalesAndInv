{
  "name": "furnitrack",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "pnpm": ">=9.0.0", "node": ">=20.0.0" },
  "scripts": {
    "build": "turbo run build",
    "build:storefront": "pnpm --filter @furnitrack/db generate && pnpm --filter storefront build",
    "build:storefront:appwrite": "pnpm build:storefront && node scripts/prepare-appwrite-next.mjs storefront",
    "build:admin": "pnpm --filter @furnitrack/db generate && pnpm --filter admin build",
    "build:admin:appwrite": "pnpm build:admin && node scripts/prepare-appwrite-next.mjs admin",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "latest",
    "eslint": "^9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp"]
  }
}
